# gongzhonghao · 环境变量样例
# 用法：cp .env.example .env 后填真值；.env 已在 .gitignore 里，永远不要提交。
# 服务器上由 systemd 的 EnvironmentFile=/etc/gzh/env 提供同一批变量（两处键名一致）。
# 只读这个文件不会被程序自动加载——本地请 `set -a; . ./.env; set +a` 或用自己的 env 管理。

# ───────────── LLM（OpenAI 兼容，必填其一） ─────────────
# 任何 OpenAI 兼容端点都行：DeepSeek / OpenCode Go / 自建网关
GZH_LLM_PROVIDER=openai-compat
GZH_LLM_BASE_URL=https://api.deepseek.com/v1
GZH_LLM_MODEL=deepseek-chat
GZH_LLM_API_KEY=
# 可选调参
GZH_LLM_TIMEOUT=120
GZH_LLM_MAX_RETRIES=3
GZH_LLM_MAX_OUTPUT=32000
GZH_LLM_USER_AGENT=gzh-pipeline/1.0

# ───────────── 飞书：群自定义机器人（当前主通道） ─────────────
# 飞书群 → 设置 → 群机器人 → 添加 → 自定义机器人 → 复制 webhook 地址
# 形如 https://open.feishu.cn/open-apis/bot/v2/hook/<uuid>
FEISHU_WEBHOOK=
# 若机器人安全设置选的是「签名校验」才需要（关键词/无校验就不用）
GZH_FEISHU_WEBHOOK_SECRET=

# ───────────── 飞书：自建应用（可选，被租户策略挡住时用不上） ─────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
GZH_FEISHU_CHAT_ID=

# ───────────── 卡片按钮回传小服务（choice_server.py） ─────────────
# 不配 GZH_CHOICE_BASE 时卡片不带按钮，手动在会话里回数字
GZH_CHOICE_TOKEN=            # openssl rand -hex 16
GZH_CHOICE_BASE=             # 例 http://<ECS 公网 IP>:8788
GZH_CHOICE_PORT=8788
GZH_CHOICE_HOST=0.0.0.0

# ───────────── 转写 ─────────────
# podwatch 的「自有命令」后端：参数是 <音频文件> -o <输出目录>，产出 <名>.transcript.json
GZH_STT_CMD=                 # 例：./tools/stt/stt -m small --device cpu --compute-type int8
YTDLP=                       # yt-dlp 可执行文件（默认会用 tools/ytdlp/yt-dlp）
YTDLP_COOKIES=               # 需要登录态的站点的 cookies.txt（可选，别提交）
YTDLP_IMPERSONATE=           # 反爬指纹，例 chrome（可选）

# ───────────── 路径 ─────────────
GZH_WORKSPACE=               # 工作区根，默认仓库上一级
GZH_BASE=                    # 案例输出目录，默认同 GZH_WORKSPACE
GZH_MEDIA_DIR=               # 视频素材目录（可选，配图抽帧用）
GZH_STATE_DIR=               # 运行态目录（choice.json 等），默认 $GZH_WORKSPACE/.state

# ───────────── 部署脚本（只在开发机用，不写进服务器 env） ─────────────
GZH_INSTANCE=                # ECS 实例 ID（阿里云）
GZH_LOCAL_WORKSPACE=         # 本机工作区绝对路径，默认 ~/Desktop/公众号
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
